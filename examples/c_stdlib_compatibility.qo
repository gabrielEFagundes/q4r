/*
    You can use external libraries with the `extern` keyword.

    ```quaoar
    extern f malloc(uint size)
    ```

    You can also use extern blocks!

    ```quaoar
    extern{
        f printf(*char st, ...)
        f scanf(*char fmtString, ...)
    }
    ```
*/
extern {
    f printf(*char s, ...)
    f scanf(*char fmt, ...)
}

f main() int{
    int var = 0

    printf("Hello, type a number in!\n> ")
    scanf("%d", &var)

    printf("You've typed %d!", var)
    return 0
}