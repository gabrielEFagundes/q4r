{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Quaoar",
  "scopeName": "source.quaoar",
  "fileTypes": ["qo", "qoa", "qua"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#constants-language" },
    { "include": "#keywords-control" },
    { "include": "#keyword-function-decl" },
    { "include": "#storage-types" },
    { "include": "#pointer-sigil" },
    { "include": "#support-functions" },
    { "include": "#functions" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.quaoar",
          "match": "//.*$"
        },
        {
          "name": "comment.block.quaoar",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.quaoar",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.quaoar",
          "match": "\\\\."
        },
        {
          "name": "meta.embedded.line.interpolation.quaoar",
          "begin": "\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.template-expression.begin.quaoar" } },
          "endCaptures": { "0": { "name": "punctuation.definition.template-expression.end.quaoar" } },
          "patterns": [
            { "name": "variable.other.interpolated.quaoar", "match": "[a-zA-Z_][a-zA-Z0-9_]*" }
          ]
        }
      ]
    },

    "chars": {
      "name": "string.quoted.single.quaoar",
      "match": "'(\\\\.|[^'\\\\])'"
    },

    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.quaoar",
          "match": "\\b[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.quaoar",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },

    "constants-language": {
      "name": "constant.language.quaoar",
      "match": "\\b(true|false)\\b"
    },

    "keywords-control": {
      "name": "keyword.control.quaoar",
      "match": "\\b(if|else|while|for|cross|return|workspace)\\b"
    },

    "keyword-function-decl": {
      "name": "storage.type.function.quaoar",
      "match": "\\bf\\b"
    },

    "storage-types": {
      "name": "storage.type.quaoar",
      "match": "\\b(int|char|float|bool|str|void|global|i16|i32|i64|f32|f64)\\b"
    },

    "pointer-sigil": {
      "comment": "the * in *char, only when glued to a type name (no space) — distinguishes pointer decls from multiplication",
      "name": "storage.modifier.pointer.quaoar",
      "match": "\\*(?=[a-zA-Z_])"
    },

    "support-functions": {
      "name": "support.function.quaoar",
      "match": "\\b(writeLine|MAX_VALUE)\\b"
    },

    "functions": {
      "name": "entity.name.function.quaoar",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*(?=\\s*\\()"
    },

    "operators": {
      "name": "keyword.operator.quaoar",
      "match": "(==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>=!])"
    },

    "punctuation": {
      "patterns": [
        { "name": "punctuation.section.block.quaoar", "match": "[{}]" },
        { "name": "punctuation.section.parens.quaoar", "match": "[()]" },
        { "name": "punctuation.separator.comma.quaoar", "match": "," },
        { "name": "punctuation.terminator.statement.quaoar", "match": ";" }
      ]
    }
  }
}
