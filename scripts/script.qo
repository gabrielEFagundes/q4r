int global_var = 10

f main() int{
    cmp(1,2)

    return 0
}

f cmp(int p1, int p2) bool{
    if p1 == p2{
        return true
    }
    return false
}

/* 
Expression types:
    1           - Literal
    1+1         - Arithmetic
    1<2         - Comparison
    (1+1) + 1   - Arithmetic + Subexpression
    (1+1) >= 2  - Arithmetic + Comparison
    1+1+1       - MTOO Arithmetic
         (More Than One Operator)
*/